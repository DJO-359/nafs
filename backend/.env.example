# Скопируйте в .env и заполните значения.
# Приложение не стартует, если обязательная переменная отсутствует или
# не проходит валидацию (см. src/config/env.validation.ts).

NODE_ENV=development
PORT=3000

# --- База данных (Postgres / Neon) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nafs
DB_USER=postgres
DB_PASSWORD=
# Для Neon и других managed-провайдеров: true. Для локального Postgres: false
DB_SSL=false
# Схема управляется миграциями (npm run db:migrate).
# true допустимо только в локальной песочнице: sync() умеет терять данные
DB_SYNC=false
DB_LOGGING=false

# --- Аутентификация ---
# Минимум 32 символа. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=7d

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Локально держите false: второй polling конфликтует с продовым ботом (409)
TELEGRAM_ENABLED=false
MINI_APP_URL=https://nafs-iota.vercel.app

# --- CORS ---
# Через запятую. localhost:5173 добавляется автоматически вне production,
# preview-домены вида https://nafs-<hash>.vercel.app разрешены всегда
CORS_ORIGINS=https://nafs-iota.vercel.app

# --- Локальная разработка вне Telegram ---
# Позволяет войти без initData. Игнорируется при NODE_ENV=production.
# Укажите свой Telegram ID, чтобы работать со своими данными.
DEV_TELEGRAM_ID=
